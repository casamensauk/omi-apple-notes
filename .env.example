# ---- relay (set these on the Railway service) ----
# Shared secret the Mac agent uses to drain the queue. Generate with:
#   openssl rand -hex 32
AGENT_TOKEN=

# Public URL Railway gives the service, e.g. https://omi-notes-relay.up.railway.app
PUBLIC_BASE_URL=

# Optional. Your Omi user id, once you know it. Leave blank and the relay pins the first
# uid it sees, so a stranger who finds the URL later cannot drive your notes.
ALLOWED_UIDS=

# Optional. Reject tool calls that do not carry this Omi app id.
OMI_APP_ID=

# Where the queue database lives. Must match the Railway volume mount path.
DB_PATH=/data/omi-notes.db

# ---- agent (set these in ~/.config/omi-notes/config.env on your Mac) ----
RELAY_URL=
# AGENT_TOKEN=   (the same value as above)
# OMI_UID=       (optional, only needed to seed the mirror before your first voice command)
# DEFAULT_FOLDER=  (Apple Notes folder for new notes; blank uses the default folder)
# MIRROR_LIMIT=60
